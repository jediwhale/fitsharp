<?xml version="1.0"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
        DefaultTargets="unittests;storytests" >
        
<PropertyGroup>
    <Config>Debug</Config>
    <PackageDirectory>$(MSBuildThisFileDirectory)nuget</PackageDirectory>
    <PackageStagingDirectory>$(PackageDirectory)\lib</PackageStagingDirectory>
    <PackageDeploymentDirectory>$(MSBuildThisFileDirectory)binary</PackageDeploymentDirectory>
    <NuspecPath>$(PackageDirectory)\FitSharp.nuspec</NuspecPath>
    <NuGetExe>$(MSBuildThisFileDirectory)binary\tools\nuget\nuget.exe</NuGetExe>
</PropertyGroup>

<Target Name="deploy" DependsOnTargets="package">
  <Error Condition="Exists('$(DeployedPackageFile)')" Text="Package already exists: $(DeployedPackageFile)" />
  <MakeDir Directories="$(PackageDeploymentDirectory)" />
  <Copy SourceFiles="$(PackageFile)" DestinationFiles="$(DeployedPackageFile)" />
</Target>

<Target Name="restore">
    <Exec Command="dotnet restore fitSharp.sln"/>
</Target>

<Target Name="solution" DependsOnTargets="restore">
    <MSBuild Projects="fitsharp.sln" Properties="Configuration=$(Config)" />
</Target>

<Target Name="releasesolution" DependsOnTargets="restore">
    <MSBuild Projects="fitsharp.sln" Properties="Configuration=Release" />
</Target>

<Target Name="unittests" DependsOnTargets="solution">
    <Exec Command="dotnet test --no-build -m:1 source\fitSharpTest\fitSharpTest.csproj" />
    <Exec Command="dotnet test --no-build -m:1 source\fitTest\fitTest.csproj" />
</Target>

<Target Name="storytests" DependsOnTargets="solution">
    <Exec Command="dotnet test --no-build -m:1 source\StoryTest\StoryTest.csproj" />
</Target>

<Target Name="package" DependsOnTargets="releasesolution">
  <RemoveDir Directories="$(PackageStagingDirectory)" />
  <ItemGroup>
    <Netfx48Files Include="
      source\fitSharp\bin\release\net48\fitSharp.dll;
      source\fit\bin\release\net48\fit.dll;
      source\Runner\bin\release\net48\Runner.exe;
      source\RunnerW\bin\release\net48\RunnerW.exe"/>
     <Net8Files Include="
      source\fitSharp\bin\release\net8.0\fitSharp.dll;
      source\fit\bin\release\net8.0\fit.dll;
      source\Runner\bin\release\net8.0\Runner.dll;
      source\Runner\bin\release\net8.0\Runner.runtimeconfig.json"/>
     <Net8WinFiles Include="
      source\fitSharp\bin\release\net8.0-windows\fitSharp.dll;
      source\fit\bin\release\net8.0-windows\fit.dll;
      source\Runner\bin\release\net8.0-windows\Runner.dll;
      source\Runner\bin\release\net8.0-windows\Runner.runtimeconfig.json;
      source\RunnerW\bin\release\net8.0-windows\RunnerW.dll;
      source\RunnerW\bin\release\net8.0-windows\RunnerW.runtimeconfig.json"/>
     <Net9Files Include="
      source\fitSharp\bin\release\net9.0\fitSharp.dll;
      source\fit\bin\release\net9.0\fit.dll;
      source\Runner\bin\release\net9.0\Runner.dll;
      source\Runner\bin\release\net9.0\Runner.runtimeconfig.json"/>
     <Net9WinFiles Include="
      source\fitSharp\bin\release\net9.0-windows\fitSharp.dll;
      source\fit\bin\release\net9.0-windows\fit.dll;
      source\Runner\bin\release\net9.0-windows\Runner.dll;
      source\Runner\bin\release\net9.0-windows\Runner.runtimeconfig.json;
      source\RunnerW\bin\release\net9.0-windows\RunnerW.dll;
      source\RunnerW\bin\release\net9.0-windows\RunnerW.runtimeconfig.json"/>
     <Net10Files Include="
      source\fitSharp\bin\release\net10.0\fitSharp.dll;
      source\fit\bin\release\net10.0\fit.dll;
      source\Runner\bin\release\net10.0\Runner.dll;
      source\Runner\bin\release\net10.0\Runner.runtimeconfig.json"/>
     <Net10WinFiles Include="
      source\fitSharp\bin\release\net10.0-windows\fitSharp.dll;
      source\fit\bin\release\net10.0-windows\fit.dll;
      source\Runner\bin\release\net10.0-windows\Runner.dll;
      source\Runner\bin\release\net10.0-windows\Runner.runtimeconfig.json;
      source\RunnerW\bin\release\net10.0-windows\RunnerW.dll;
      source\RunnerW\bin\release\net10.0-windows\RunnerW.runtimeconfig.json"/>
     <Net11Files Include="
      source\fitSharp\bin\release\net11.0\fitSharp.dll;
      source\fit\bin\release\net11.0\fit.dll;
      source\Runner\bin\release\net11.0\Runner.dll;
      source\Runner\bin\release\net11.0\Runner.runtimeconfig.json"/>
     <Net11WinFiles Include="
      source\fitSharp\bin\release\net11.0-windows\fitSharp.dll;
      source\fit\bin\release\net11.0-windows\fit.dll;
      source\Runner\bin\release\net11.0-windows\Runner.dll;
      source\Runner\bin\release\net11.0-windows\Runner.runtimeconfig.json;
      source\RunnerW\bin\release\net11.0-windows\RunnerW.dll;
      source\RunnerW\bin\release\net11.0-windows\RunnerW.runtimeconfig.json"/>
    <PackageFiles Include="
      @(Netfx48Files);
      @(Net8Files);
      @(Net8WinFiles);
      @(Net9Files);
      @(Net9WinFiles);
      @(Net10Files);
      @(Net10WinFiles);
      @(Net11Files);
      @(Net11WinFiles)" />
  </ItemGroup>
  <Error Condition="!Exists('$(NuGetExe)')" Text="NuGet executable not found: $(NuGetExe)" />
  <Error Condition="!Exists('$(NuspecPath)')" Text="NuGet specification not found: $(NuspecPath)" />
  <Error Condition="!Exists('%(PackageFiles.Identity)')" Text="Package input not found: %(PackageFiles.Identity)" />
  <XmlPeek XmlInputPath="$(NuspecPath)"
           Query="/nuspec:package/nuspec:metadata/nuspec:id/text()"
           Namespaces="&lt;Namespace Prefix='nuspec' Uri='http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd' /&gt;">
    <Output TaskParameter="Result" PropertyName="PackageId" />
  </XmlPeek>
  <XmlPeek XmlInputPath="$(NuspecPath)"
           Query="/nuspec:package/nuspec:metadata/nuspec:version/text()"
           Namespaces="&lt;Namespace Prefix='nuspec' Uri='http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd' /&gt;">
    <Output TaskParameter="Result" PropertyName="PackageVersion" />
  </XmlPeek>
  <Error Condition="'$(PackageId)' == ''" Text="Package ID not found in $(NuspecPath)" />
  <Error Condition="'$(PackageVersion)' == ''" Text="Package version not found in $(NuspecPath)" />
  <PropertyGroup>
    <PackageFile>$(PackageDirectory)\$(PackageId).$(PackageVersion).nupkg</PackageFile>
    <DeployedPackageFile>$(PackageDeploymentDirectory)\$(PackageId).$(PackageVersion).nupkg</DeployedPackageFile>
  </PropertyGroup>
  <Copy SourceFiles="@(Netfx48Files)" DestinationFolder="$(PackageStagingDirectory)\net48" />
  <Copy SourceFiles="@(Net8Files)" DestinationFolder="$(PackageStagingDirectory)\net8.0" />
  <Copy SourceFiles="@(Net8WinFiles)" DestinationFolder="$(PackageStagingDirectory)\net8.0-windows" />
  <Copy SourceFiles="@(Net9Files)" DestinationFolder="$(PackageStagingDirectory)\net9.0" />
  <Copy SourceFiles="@(Net9WinFiles)" DestinationFolder="$(PackageStagingDirectory)\net9.0-windows" />
  <Copy SourceFiles="@(Net10Files)" DestinationFolder="$(PackageStagingDirectory)\net10.0" />
  <Copy SourceFiles="@(Net10WinFiles)" DestinationFolder="$(PackageStagingDirectory)\net10.0-windows" />
  <Copy SourceFiles="@(Net11Files)" DestinationFolder="$(PackageStagingDirectory)\net11.0" />
  <Copy SourceFiles="@(Net11WinFiles)" DestinationFolder="$(PackageStagingDirectory)\net11.0-windows" />
  <Exec Command="&quot;$(NuGetExe)&quot; pack FitSharp.nuspec -OutputDirectory &quot;$(PackageDirectory)&quot; -NonInteractive"
        WorkingDirectory="$(PackageDirectory)" />
  <Error Condition="!Exists('$(PackageFile)')" Text="NuGet package was not created: $(PackageFile)" />
</Target>

</Project>
